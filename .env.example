# ─────────────────────────────────────────────────────────────────────────────
# DropZero environment
#
# Leave EVERYTHING blank to run in zero-credential preview mode (in-memory).
# Fill in the DSQL values to switch the whole app onto real Aurora DSQL.
#
# On Vercel: do NOT paste AWS keys. Use the Marketplace "Amazon Aurora DSQL"
# integration — it wires OIDC so Vercel assumes an IAM role with no stored
# secrets, and injects DSQL_CLUSTER_ENDPOINT / AWS_REGION for you.
# ─────────────────────────────────────────────────────────────────────────────

# Aurora DSQL cluster endpoint, e.g. abcd1234.dsql.us-east-1.on.aws
DSQL_CLUSTER_ENDPOINT=
AWS_REGION=us-east-1
DSQL_USER=admin
DSQL_DATABASE=postgres

# Optional: a friendly label shown in the UI / stamped on orders ("us-east-1")
APP_REGION_LABEL=

# Local dev only — the AWS credential chain DsqlSigner uses to mint IAM tokens.
# (On Vercel these are supplied by the OIDC integration; do not set them there.)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: Stripe TEST-mode key to make checkout "monetizable" in the demo.
STRIPE_SECRET_KEY=
